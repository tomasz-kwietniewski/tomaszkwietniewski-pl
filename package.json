{
  "name": "tomaszkwietniewski-pl",
  "version": "1.0.0",
  "private": true,
  "description": "Statyczna strona tomaszkwietniewski.pl (Eleventy)",
  "type": "module",
  "scripts": {
    "clean": "node tools/clean.mjs",
    "yt-thumbs": "node tools/fetch_yt_thumbs.mjs",
    "build": "npm run clean && npm run yt-thumbs && eleventy && pagefind --site _site",
    "dev": "npm run clean && npm run yt-thumbs && eleventy --serve",
    "check": "node tools/test_daty.mjs && node tools/verify_build.mjs",
    "verify": "npm run build && npm run check"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.2",
    "gray-matter": "^4.0.3",
    "markdown-it": "^14.1.0",
    "pagefind": "^1.3.0"
  }
}
