<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{%- set pelnyTytul = (title + " - " + site.autor) if title else site.title %}
<title>{{ pelnyTytul }}</title>
<meta name="description" content="{{ opisSEO or site.description }}">
<link rel="canonical" href="{{ page.url | absUrl(site.url) }}">
{%- if noindex %}
<meta name="robots" content="noindex">
{%- endif %}
<meta property="og:type" content="{{ 'article' if ogTyp == 'article' else 'website' }}">
<meta property="og:title" content="{{ pelnyTytul }}">
<meta property="og:description" content="{{ opisSEO or site.description }}">
<meta property="og:url" content="{{ page.url | absUrl(site.url) }}">
<meta property="og:image" content="{{ (ogObrazek or '/assets/img/plaza.jpg') | absUrl(site.url) }}">
<meta property="og:site_name" content="{{ site.autor }}">
<meta property="og:locale" content="pl_PL">
{%- if ogTyp == 'article' and wpis %}
<meta property="article:published_time" content="{{ wpis.date | isoDate }}">
<meta property="article:modified_time" content="{{ wpis.modified | isoDate }}">
<meta property="article:author" content="{{ site.autor }}">
{%- endif %}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ pelnyTytul }}">
<meta name="twitter:description" content="{{ opisSEO or site.description }}">
<meta name="twitter:image" content="{{ (ogObrazek or '/assets/img/plaza.jpg') | absUrl(site.url) }}">
{%- if jsonLd %}
<script type="application/ld+json">{{ jsonLd | safe }}</script>
{%- endif %}
{%- if page.url == "/" %}
{%- set jsonLdStrona = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "WebSite", "name": site.title, "url": site.url, "description": site.description, "inLanguage": "pl-PL" },
    { "@type": "Person", "name": site.autor, "url": site.url, "sameAs": [site.github] }
  ]
} %}
<script type="application/ld+json">{{ jsonLdStrona | dump | safe }}</script>
{%- endif %}
<link rel="icon" type="image/svg+xml" href="/assets/img/favicon.svg">
<link rel="alternate" type="application/rss+xml" title="{{ site.autor }} - RSS" href="/feed.xml">
{# Preload obu subsetów: polskie diakrytyki (ą ę ł...) są w latin-ext - preload
   samego latin dawał FOUT dokładnie na polskich znakach. #}
<link rel="preload" href="/assets/fonts/bricolage-grotesque-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/assets/fonts/bricolage-grotesque-latin-ext-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/assets/fonts/archivo-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/assets/fonts/archivo-latin-ext-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/assets/css/style.css">
